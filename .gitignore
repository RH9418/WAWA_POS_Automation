# -------------------------------------
# WAWA AUTOMATION SPECIFIC OUTPUT FILES
# -------------------------------------
# Ignore all downloaded PDFs and UI screenshots
downloaded_receipts/

# Ignore all generated XML screenshots
xml_visual_evidence/

# Ignore all generated Excel reports
test_evidence/
*.xlsx

# Ignore the dynamically generated JSON ledgers
