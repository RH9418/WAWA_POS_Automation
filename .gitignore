ui_scraped_results.json
xml_batch_results.json
comparison_results.json
target_receipts.json

# Ignore loose screenshots or PDFs in the root
*.png
*.pdf

# Security / Credentials
.env
*auth_state*.json
*auth_state*.json.bak
